# Copia a .env y rellena (el archivo .env no se sube a Git).
# Usado por server.js en la raíz del proyecto (proxy Gemini + admin).

PORT=3000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Contraseña maestra: guardar únicamente el hash bcrypt codificado en Base64.
# Generar con: php laravel/scripts/make-master-hash.php "tu_clave"
ADMIN_PASSWORD_HASH_B64=
ADMIN_JWT_SECRET=
ADMIN_JWT_EXPIRES=8h
ADMIN_COOKIE_NAME=WorkColbeef_admin_token

# Power BI PIN (privacidad) — recomendado en Base64
POWERBI_PIN_HASH_B64=
# PIN secundario común para accesos protegidos — bcrypt en Base64
SECONDARY_PIN_HASH_B64=

NODE_ENV=development
